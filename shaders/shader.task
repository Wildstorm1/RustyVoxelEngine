#version 450

#extension GL_EXT_mesh_shader : require

#pragma shader_stage(task)

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 model;
    vec3 size;
} ubo;

void main() {
    EmitMeshTasksEXT(
        uint(ubo.size.x),
        uint(ubo.size.y),
        uint(ubo.size.z)
    );
}