#version 450

#extension GL_EXT_mesh_shader : require

#pragma shader_stage(mesh)

layout(local_size_x = 1) in;
layout(triangles) out;
layout(max_vertices = 16, max_primitives = 8) out;

layout(location = 0) out vec3 fragColor[];

layout(set = 0, binding = 0) uniform UniformBufferObject {
    mat4 model;
} ubo;

layout(push_constant) uniform Constants {
    mat4 view;
    mat4 proj;
} camera;

vec4 positions[3] = vec4[] (
    vec4(0.0, -0.5, 0.0, 1.0),
    vec4(0.5, 0.5, 0.0, 1.0),
    vec4(-0.5, 0.5, 0.0, 1.0)
);

vec3 colors[3] = vec3[] (
    vec3(1.0, 0.0, 0.0),
    vec3(0.0, 1.0, 0.0),
    vec3(0.0, 0.0, 1.0)
);

void main() {
    SetMeshOutputsEXT(3, 1);

    gl_MeshVerticesEXT[0].gl_Position = positions[0];
    gl_MeshVerticesEXT[1].gl_Position = positions[2];
    gl_MeshVerticesEXT[2].gl_Position = positions[1];

    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);

    fragColor[0] = colors[0];
    fragColor[1] = colors[1];
    fragColor[2] = colors[2];
}